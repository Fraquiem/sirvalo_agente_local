# Backend Configuration
PORT=8000
ENVIRONMENT=development
CORS_ORIGINS=http://localhost:5173,http://127.0.0.1:5173,http://localhost:3000,http://127.0.0.1:3000

# Supabase Configuration
SUPABASE_URL=https://your-project-ref.supabase.co
SUPABASE_ANON_KEY=your-anon-or-publishable-key-here
# Sólo backend; nunca exponer en frontend ni confirmar un valor real.
SUPABASE_SERVICE_ROLE_KEY=your-service-role-key-here

# Ollama LLM Configuration
OLLAMA_BASE_URL=http://127.0.0.1:11434
OLLAMA_MODEL=qwen3.5:9b
OLLAMA_EMBEDDING_MODEL=bge-m3
EMBEDDING_DIMENSIONS=1024
OLLAMA_TIMEOUT_SECONDS=300
OLLAMA_MAX_OUTPUT_TOKENS=512
RETRIEVAL_THRESHOLD=0.55
INGREDIENT_RETRIEVAL_THRESHOLD=0.40
RETRIEVAL_FOLLOWUP_THRESHOLD=0.35

# TheCocktailDB / ingestion (backend only)
THECOCKTAILDB_BASE_URL=https://www.thecocktaildb.com/api/json/v1/1
THECOCKTAILDB_TIMEOUT_SECONDS=20
THECOCKTAILDB_MAX_ITEMS=100
ADMIN_INGEST_KEY=replace-with-a-local-admin-secret
MAX_UPLOAD_BYTES=10485760
CHUNK_SIZE=1200
CHUNK_OVERLAP=200
SUPABASE_TIMEOUT_SECONDS=20

# Frontend Environment Variables (Vite requires VITE_ prefix)
VITE_SUPABASE_URL=https://your-project-ref.supabase.co
VITE_SUPABASE_ANON_KEY=your-anon-key-here
VITE_API_BASE_URL=http://localhost:8000
